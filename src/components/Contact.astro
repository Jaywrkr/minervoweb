---
import { contact } from '../data/content.js';
const mailHref = contact.email.startsWith('[') ? '#contacto' : `mailto:${contact.email}`;
---
<section id="contacto" class="sec contact" data-mode="glyph">
  <div class="wrap">
    <div class="txt">
      <span class="mono eyebrow">contacto</span>
      <h2>¿tu marca debería <span class="hl">moverse</span>?</h2>
      <div class="mail">
        <a class="pill rosa" href={mailHref}>{contact.email}</a>
        <a class="pill ghost" href={contact.whatsapp}>whatsapp</a>
      </div>
      <div class="poster-tools" data-poster hidden>
        <span class="mono hint">esta ə es única: cada visita la arma distinto</span>
        <div class="poster-btns">
          <button type="button" class="btn" data-remix>remezclar</button>
          <button type="button" class="btn" data-download>descargar póster</button>
        </div>
      </div>
    </div>
    <div class="anchor" data-anchor data-want="60"></div>
  </div>
</section>
