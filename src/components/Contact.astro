---
import { contact } from '../data/content.js';
const mailHref = contact.email.startsWith('[') ? '#contacto' : `mailto:${contact.email}`;
---
<section id="contacto" class="sec contact" data-mode="glyph">
  <div class="wrap">
    <div class="txt">
      <span class="mono eyebrow">contacto</span>
      <h2>¿tu marca debería <span>moverse</span>?</h2>
      <div class="mail">
        <a class="pill rosa" href={mailHref}>{contact.email}</a>
        <a class="pill ghost" href={contact.whatsapp}>whatsapp</a>
      </div>
    </div>
    <div class="anchor" data-anchor></div>
  </div>
</section>
