---
// Trabajo como lista tipográfica. Con mouse, la imagen del caso sigue al cursor;
// en pantallas táctiles, cada fila muestra su miniatura.
import { cases } from '../data/content.js';
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section id="trabajo" class="sec work" data-mode="chaos">
  <div class="wrap">
    <div class="head">
      <span class="mono eyebrow">trabajo seleccionado</span>
      <h2>cientos de páginas. estas son seis.</h2>
    </div>
    <ol class="work-list" id="workList">
      {cases.map((c, i) => (
        <li>
          <a class="work-row" href={`/casos/${c.slug}/`} data-i={i} style={`--c:var(--${c.bg})`}>
            <span class="mono n">{num(i)}</span>
            <strong style={`view-transition-name:title-${c.slug}`}>{c.client}</strong>
            <span class="mono t">{c.type}</span>
            <span class="mono y">{c.year}</span>
            <span class="thumb shot" aria-hidden="true" style={`background:var(--${c.bg});view-transition-name:shot-${c.slug}`}>
              {c.video ? <video src={c.video} muted loop playsinline preload="none"></video> : c.shot.map((b) => <b style={b.s}></b>)}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
  <div class="peek" id="peek" aria-hidden="true">
    {cases.map((c, i) => (
      <div class="peek-item shot" data-i={i} style={`background:var(--${c.bg})`}>
        {c.video ? <video src={c.video} muted loop playsinline preload="none"></video> : c.shot.map((b) => <b style={b.s}></b>)}
        <span class="mono tag">{c.type} · {c.year}</span>
      </div>
    ))}
  </div>
</section>

<script>
  // se conecta en cada página (el router de Astro cambia el contenido sin recargar)
  document.addEventListener('astro:page-load', () => {
  const list = document.getElementById('workList');
  const peek = document.getElementById('peek');
  const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (list && peek && canHover) {
    let x = 0, y = 0, px = 0, py = 0, active = -1, running = false;
    const items = [...peek.querySelectorAll<HTMLElement>('.peek-item')];

    const show = (i: number) => {
      if (i === active) return;
      items.forEach((el, k) => {
        el.classList.toggle('on', k === i);
        const v = el.querySelector('video');
        if (v) k === i ? v.play().catch(() => {}) : v.pause();
      });
      active = i;
    };
    const tick = () => {
      const k = reduce ? 1 : 0.16;
      const vx = (x - px) * k;
      px += vx; py += (y - py) * k;
      const rot = reduce ? 0 : Math.max(-10, Math.min(10, vx * 0.35));
      peek.style.transform = `translate3d(${px}px, ${py}px, 0) rotate(${rot}deg)`;
      if (running) requestAnimationFrame(tick);
    };

    list.addEventListener('pointerenter', (e) => {
      x = px = e.clientX; y = py = e.clientY;
      peek.classList.add('is-on');
      if (!running) { running = true; tick(); }
    });
    list.addEventListener('pointerleave', () => {
      peek.classList.remove('is-on');
      running = false;
      show(-1);
    });
    list.addEventListener('pointermove', (e) => { x = e.clientX; y = e.clientY; });
    list.querySelectorAll<HTMLElement>('.work-row').forEach((row) => {
      row.addEventListener('pointerenter', () => show(Number(row.dataset.i)));
      row.addEventListener('focus', () => show(Number(row.dataset.i)));
    });
  }
  });
</script>
