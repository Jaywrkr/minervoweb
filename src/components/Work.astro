---
import { cases } from '../data/content.js';
---
<section id="trabajo" class="sec" data-mode="chaos">
  <div class="wrap">
    <div class="head">
      <span class="mono eyebrow">trabajo seleccionado</span>
      <h2>cientos de páginas. estas son seis.</h2>
    </div>
    <div class="cases">
      {cases.map((c, i) => (
        <a class="case" href="#trabajo">
          <div class="shot" style={`background:var(--${c.bg})`}>
            {c.shot.map((b) => <b style={b.s}></b>)}
            <span class="mono tag">[ video caso {String(i + 1).padStart(2, '0')} ]</span>
          </div>
          <div class="meta"><strong>{c.client}</strong><span class="mono">{c.type} · {c.year}</span></div>
        </a>
      ))}
    </div>
  </div>
</section>
