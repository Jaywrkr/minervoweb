---
import { services } from '../data/content.js';
---
<section id="servicios" class="sec" data-mode="slots" data-music="1">
  <div class="wrap">
    <div class="head">
      <span class="mono eyebrow">servicios</span>
      <h2>seis formas de mover una marca.</h2>
        <span class="mono hint">activa el sonido y pasa por cada servicio: cada uno es un instrumento</span>
    </div>
    <div class="svc">
      {services.map((s) => (
        <div class="card" tabindex="0" data-instrument={s.slot}>
          <div class="slot" data-slot={s.slot}></div>
          <span class="mono">{s.tag}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
