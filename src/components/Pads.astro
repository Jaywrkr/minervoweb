---
// Pads de las formas, plegados por defecto para no tapar contenido.
// Las teclas A–H funcionan siempre, estén abiertos o no.
import { KINDS, ICONS } from '../scripts/kinds.js';
---
<div class="padbox" data-open="false">
  <div class="keys" id="pads" role="group" aria-label="Soltar formas" hidden>
    {KINDS.map((k) => (
      <button type="button" class="key" data-key={k.key} aria-label={`Soltar ${k.name} (tecla ${k.key.toUpperCase()})`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[k.id]} />
        <kbd>{k.key.toUpperCase()}</kbd>
      </button>
    ))}
  </div>
  <button type="button" class="padtoggle" id="padtoggle" aria-expanded="false" aria-controls="pads">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5" fill="var(--menta)" />
      <rect x="13" y="2.5" width="9" height="9" fill="var(--violeta)" />
      <path d="M2.5 13.5 L11.5 18 L2.5 22.5 Z" fill="var(--verde)" />
      <rect x="13" y="15.5" width="9" height="5" rx="2.5" fill="var(--rosa)" />
    </svg>
    <span class="sr-only">Pads de formas</span>
  </button>
</div>

<script>
  const toggle = document.getElementById('padtoggle');
  const pads = document.getElementById('pads');
  const box = toggle?.closest('.padbox');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    box?.setAttribute('data-open', String(open));
    if (pads) pads.hidden = !open;
  });
</script>
