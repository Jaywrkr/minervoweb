---
// Laboratorio F1: prototipo de las formas en 3D. No está enlazado desde el sitio ni se indexa.
import Base from '../../layouts/Base.astro';
import { KINDS, ICONS } from '../../scripts/kinds.js';
---
<Base title="lab 3D — minərvo.studio" description="Prototipo 3D de las formas de Minervo." noindex>
  <div class="lab">
    <div class="lab-stage" id="stage"></div>
    <header class="lab-bar">
      <span class="wm">minərvo<i>.</i>studio <span class="mono lab-tag">lab · prototipo 3D</span></span>
      <div class="lab-actions">
        <button class="btn" id="form" type="button" aria-pressed="false"><span class="dot"></span><span id="formTxt">formar ə</span></button>
        <button class="btn" id="sound" type="button" aria-pressed="false"><span class="dot"></span><span id="soundTxt">sonido</span></button>
      </div>
    </header>
    <footer class="lab-foot">
      <div class="lab-pads" role="group" aria-label="Soltar formas">
        {KINDS.map((k) => (
          <button type="button" class="key" data-kind={k.id} aria-label={`Soltar ${k.name}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[k.id]} />
            <kbd>{k.key.toUpperCase()}</kbd>
          </button>
        ))}
      </div>
      <span class="mono lab-hint">mueve el mouse para empujar · toca una forma · espacio arma la ə</span>
    </footer>
  </div>
</Base>

<style>
  .lab { position: fixed; inset: 0; }
  .lab-stage { position: absolute; inset: 0; }
  .lab-stage :global(canvas) { display: block; width: 100%; height: 100%; touch-action: none; }
  .lab-bar, .lab-foot {
    position: absolute; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap;
    padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); pointer-events: none;
  }
  .lab-bar > *, .lab-foot > * { pointer-events: auto; }
  .lab-bar { top: env(safe-area-inset-top, 0px); padding-block: 20px; }
  .lab-foot { bottom: env(safe-area-inset-bottom, 0px); padding-block: 16px; }
  .lab-tag { color: var(--muted); margin-left: 12px; }
  .lab-actions, .lab-pads { display: flex; gap: 8px; flex-wrap: wrap; }
  .lab-hint { color: var(--muted); }
  @media (max-width: 700px) { .lab-hint, .lab-tag { display: none; } }
</style>

<script>
  import { initLab } from '../../scripts/lab3d.js';
  import { KINDS } from '../../scripts/kinds.js';
  const formBtn = document.getElementById('form');
  const formTxt = document.getElementById('formTxt');
  const soundBtn = document.getElementById('sound');
  const soundTxt = document.getElementById('soundTxt');
  const lab = initLab({
    mount: document.getElementById('stage') as HTMLElement,
    ui: {
      onSound(on: boolean) {
        soundBtn?.setAttribute('aria-pressed', String(on));
        if (soundTxt) soundTxt.textContent = on ? 'sonido on' : 'sonido';
      },
    },
  });
  const toggleForm = () => {
    const on = lab.toggleForm();
    formBtn?.setAttribute('aria-pressed', String(on));
    if (formTxt) formTxt.textContent = on ? 'soltar' : 'formar ə';
  };
  formBtn?.addEventListener('click', toggleForm);
  soundBtn?.addEventListener('click', () => lab.toggleSound());
  document.querySelectorAll<HTMLElement>('.lab-pads [data-kind]').forEach((b) => {
    b.addEventListener('click', () => lab.drop(KINDS.find((k) => k.id === b.dataset.kind)));
  });
  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.repeat) return;
    if (e.key === ' ') { e.preventDefault(); toggleForm(); return; }
    const k = KINDS.find((k) => k.key === e.key.toLowerCase());
    if (k) lab.drop(k);
  });
</script>
