  /* ===== A Todo Terreno: arena y tinta, Anton en mayúsculas, sellos de pasaporte, polvo ===== */
  .dl[data-brand=todoterreno]{--ease:cubic-bezier(.22,.68,0,1);--dur:.55s;--enter:dl-stampin;--edur:.55s;--eease:cubic-bezier(.22,.68,0,1.4);--stag:80ms;--idle:dl-breathe;--idur:4s}
