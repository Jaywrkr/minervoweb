  .dl[data-brand=jay] .dl-tile span:last-child{display:none}
  .dl[data-brand=jay] .dl-ticker{border:0;border-top:1px solid #262626;border-bottom:1px solid #262626;border-radius:0;background:none!important}
  .dl[data-brand=jay] .dl-track{animation-duration:90s}
  .dl[data-brand=jay] .dl-track span{font-size:13px;font-weight:500;padding:14px 0 14px 28px;color:#8a8a8a}
  .dl[data-brand=jay] .dl-track i{margin-left:28px}
  .dl[data-brand=jay] .dl-services .dl-card{min-height:calc(200px * var(--s))}
  .dl[data-brand=jay] .dl-services h2{font-size:min(calc(30px * var(--s)),24px);letter-spacing:0}
  .dl[data-brand=jay] .dl-services p{font-weight:400;font-size:14px;opacity:.6}
  .dl[data-brand=jay] .dl-services li{border:0;padding:2px 0;font-size:13px}
  .dl[data-brand=jay] .dl-services li::before{content:"— "}
  .dl[data-brand=jay] .dl-meta b{font-size:18px;letter-spacing:0}
  .dl[data-brand=jay] .dl-meta span{font-size:12px}
  .dl[data-brand=jay] .dl-thumb{border-radius:0;background:none;border-color:#262626}
  .dl[data-brand=jay] .dl-wm{font-size:22px;letter-spacing:0}
  ::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
  ::view-transition-new(root){animation:dl-wipe .9s cubic-bezier(.16,1,.3,1)}
  @keyframes dl-wipe{from{clip-path:inset(0 0 0 100%)}to{clip-path:inset(0 0 0 0)}}

  /* ===================== animación por marca ===================== */
  .dl{--enter:dl-up;--edur:1s;--eease:cubic-bezier(.16,1,.3,1);--stag:60ms;--idle:dl-float;--idur:5s}
  @keyframes dl-up{0%{opacity:0;translate:0 28px}100%{opacity:1;translate:0 0}}
  .dl[data-brand=coresolutions]{--enter:dl-load;--edur:.55s;--eease:cubic-bezier(.2,0,0,1);--stag:55ms;--idle:dl-led;--idur:1.8s}
  .dl[data-brand=jay]{--enter:dl-fade;--edur:1.3s;--eease:cubic-bezier(.4,0,.2,1);--stag:140ms;--idle:dl-breathe;--idur:6s}

  /* entradas (solo con JS activo) */
  .dl.rv-on [data-rv]{opacity:0}
  .dl.rv-on [data-rv].in{opacity:1;animation:var(--enter) var(--edur) var(--eease) backwards;animation-delay:calc(var(--i,0) * var(--stag))}
  @keyframes dl-pop{0%{opacity:0;scale:.82;rotate:-5deg;translate:0 46px}60%{opacity:1;scale:1.03;rotate:1.5deg;translate:0 -4px}100%{opacity:1;scale:1;rotate:0deg;translate:0 0}}
  @keyframes dl-load{0%{opacity:1;clip-path:inset(0 100% 0 0)}100%{opacity:1;clip-path:inset(0 0 0 0)}}
  @keyframes dl-fade{0%{opacity:0;translate:0 14px}100%{opacity:1;translate:0 0}}

  /* titular */
  .dl-h1 .caret{display:none}
  .dl[data-brand=minervo] .dl-h1.h-in .ch{animation:dl-mask 1.1s cubic-bezier(.16,1,.3,1) both;animation-delay:calc(var(--li) * 12ms + 150ms)}
  @keyframes dl-mask{0%{translate:0 .6em;clip-path:inset(0 0 100% 0)}100%{translate:0 0;clip-path:inset(-10% -10% -25% -10%)}}
  @keyframes dl-drop{0%{opacity:0;translate:0 -.7em;scale:1 .7}55%{opacity:1;translate:0 .06em;scale:1 1.08}100%{opacity:1;translate:0 0;scale:1 1}}
  .dl[data-brand=jay] .dl-h1.h-in .ch{animation:dl-type .01s steps(1) both;animation-delay:calc(var(--li) * 55ms + 300ms)}
  .dl[data-brand=jay] .dl-h1.h-in .hlw{animation:dl-type .01s steps(1) both;animation-delay:calc(var(--hl0,0) * 55ms + 300ms)}
  .dl[data-brand=minervo] .dl-h1.h-in .hlw{animation:dl-pop .7s cubic-bezier(.34,1.56,.64,1) both;animation-delay:calc(var(--hl0,0) * 26ms + 60ms)}
  @keyframes dl-type{from{opacity:0}to{opacity:1}}
  .dl[data-brand=jay] .dl-h1 .caret{display:inline-block;width:.55em;height:.95em;background:currentColor;vertical-align:-.1em;margin-left:.12em;animation:dl-blink 1s steps(1) infinite}
  @keyframes dl-blink{50%{opacity:0}}
  .dl[data-brand=coresolutions] .dl-h1 .ch{font-variant-numeric:tabular-nums}

  /* formas en reposo */
  .dl-comp .fl{transform-box:fill-box;transform-origin:center;animation:var(--idle) var(--idur) ease-in-out infinite alternate;animation-delay:calc(var(--d) * -1s)}
  .dl-comp .sh{transition:fill .7s,stroke .7s,translate .35s cubic-bezier(.34,1.56,.64,1)}
  @keyframes dl-float{from{translate:0 -2.5px;rotate:-2deg}to{translate:0 2.5px;rotate:2deg}}
  @keyframes dl-led{0%,70%{opacity:1}71%,100%{opacity:.35}}
  @keyframes dl-breathe{from{scale:.9}to{scale:1}}
  .dl[data-brand=coresolutions] .dl-comp .ov path{stroke-dasharray:10 14;animation:dl-flow 1.1s linear infinite}
  @keyframes dl-flow{to{stroke-dashoffset:-48}}

  /* hover por marca */
  .dl[data-brand=coresolutions] .dl-services .dl-card{position:relative;overflow:hidden}
  .dl[data-brand=coresolutions] .dl-services .dl-card::after{content:"";position:absolute;left:0;right:0;top:-30%;height:30%;background:linear-gradient(transparent,rgba(255,255,255,.14),transparent);pointer-events:none;opacity:0}
  .dl[data-brand=coresolutions] .dl-services .dl-card:hover::after{opacity:1;animation:dl-scan 1.2s linear infinite}
  @keyframes dl-scan{to{top:100%}}
  .dl[data-brand=coresolutions] .dl-card:hover{box-shadow:inset 0 0 0 1px #2d43e7,0 4px 12px rgba(1,9,92,.16);z-index:1}
  .dl[data-brand=jay] .dl-services .dl-card:hover,.dl[data-brand=jay] .dl-case:hover{background:#fff;color:#000;transition:background .5s,color .5s}
  .dl[data-brand=jay] .dl-services .dl-card:hover *,.dl[data-brand=jay] .dl-case:hover *{color:#000;border-color:#000}

  /* cursor por marca */
  .dl.cur-on,.dl.cur-on a,.dl.cur-on button{cursor:none}
  .dl.cur-on .dl-console,.dl.cur-on .dl-console button{cursor:pointer}
  .dl.cur-on .knob{cursor:ns-resize}
  .dl-cur{position:fixed;left:0;top:0;z-index:9;pointer-events:none;width:0;height:0}
  .dl-cur::before{content:"";position:absolute;left:-18px;top:-18px;width:36px;height:36px;border-radius:50%;background:var(--p1);mix-blend-mode:multiply;transition:scale .35s cubic-bezier(.34,1.56,.64,1),opacity .2s,border-radius .3s,background .3s}
  .dl-cur.is-hot::before{scale:1.9}
  .dl-cur.is-off{opacity:0}
  .dl-cur-lbl{display:none}
  .dl[data-brand=coresolutions] .dl-cur::before{left:-6px;top:-6px;width:12px;height:12px;border-radius:0;background:none;border:1.5px solid #2d43e7;mix-blend-mode:normal}
  .dl[data-brand=coresolutions] .dl-cur::after{content:"";position:absolute;left:-100vw;top:0;width:200vw;height:1px;background:rgba(45,67,231,.22)}
  .dl[data-brand=coresolutions] .dl-cur-lbl{display:block;position:absolute;left:14px;top:12px;font-family:var(--mono);font-size:11px;letter-spacing:.06em;color:#2d43e7;white-space:nowrap;background:#fff;padding:2px 5px;border:1px solid #c8ccd5}
  .dl[data-brand=coresolutions] .dl-cur-lbl::before{content:"";position:absolute;left:-14px;top:-100vh;width:1px;height:200vh;background:rgba(45,67,231,.22)}
  .dl[data-brand=coresolutions] .dl-cur.is-hot::before{scale:2.2;background:rgba(45,67,231,.12)}
  .dl[data-brand=jay] .dl-cur::before{left:-6px;top:-6px;width:12px;height:12px;border-radius:0;background:#fff;mix-blend-mode:difference}
  .dl[data-brand=jay] .dl-cur.is-hot::before{scale:4}

  /* transición al vestir, por marca */
  html[data-vt=coresolutions]::view-transition-new(root){animation:dl-vt-scan .6s cubic-bezier(.2,0,0,1)}
  @keyframes dl-vt-scan{from{clip-path:inset(0 0 100% 0)}to{clip-path:inset(0 0 0 0)}}
  html[data-vt=jay]::view-transition-old(root){animation:dl-vt-out .5s ease both}
  html[data-vt=jay]::view-transition-new(root){animation:dl-vt-in .9s .35s ease both}
  @keyframes dl-vt-out{to{opacity:0}}
  @keyframes dl-vt-in{from{opacity:0}}

  /* ===== ANKLA: negro, mono fino que remata en negrita, píldoras en mayúsculas, salvia y terracota, radar ===== */
  .dl[data-brand=ankla]{--ease:cubic-bezier(.16,1,.3,1);--dur:.7s;--enter:dl-rise;--edur:.9s;--eease:cubic-bezier(.16,1,.3,1);--stag:90ms;--idle:dl-breathe;--idur:5s}
