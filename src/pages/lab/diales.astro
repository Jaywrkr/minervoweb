---
// Laboratorio — "la web es el sistema", con la dirección visual fresca (fondo crema, bloques de color,
// tarjetas redondeadas, display grueso). Cuatro diales rediseñan la página en vivo; "vestir" la pone con
// la identidad de otra marca. Cada combinación es una edición numerada que se comparte por URL.
import Base from '../../layouts/Base.astro';
import { VOICES } from '../../scripts/voces.js';
const V = VOICES.minervo;
const navCC = ['p5', 'p1', 'p2', 'p0'];
const svcCC = ['p0', 'p1', 'p4', 'p2'];
const workCC = ['p5', 'p3', 'p4'];
---
<Base title="minərvo — diales (laboratorio)" description="Prototipo: la web es el sistema." noindex>
  <div class="dl" id="dl" data-brand="minervo">
    <header class="dl-nav">
      <a class="dl-wm" href="#"><span id="wm">minərvo</span><i>.</i><span class="dl-wear" id="wear"></span></a>
      <nav class="dl-tiles" aria-label="Principal">
        {V.nav.map((label, i) => <a class="dl-tile" data-rv href="#" style={`--cc:var(--${navCC[i]})`} data-cc={navCC[i]}><span data-t={`nums.${i}`}>{V.nums[i]}</span><b data-t={`nav.${i}`}>{label}</b><span aria-hidden="true">↗</span></a>)}
      </nav>
      <span class="dl-pill dl-ed" id="edTop">edición nº —</span>
    </header>

    <main id="contenido" class="dl-page">
      <section class="dl-bento">
        <div class="dl-card dl-hero" data-rv style="--cc:var(--paper)" data-cc="paper">
          <span class="dl-pill" data-t="kicker">{V.kicker}</span>
          <h1 class="dl-h1" id="h1" aria-label={V.h1}>{V.h1}</h1>
          <p class="dl-lead" data-t="lead">{V.lead}</p>
          <a class="dl-cta" href="#" data-t="cta">{V.cta}</a>
        </div>
        <div class="dl-card dl-art" data-rv style="--cc:var(--p5)" data-cc="p5">
          <svg class="dl-comp" id="comp" viewBox="0 0 1000 1000" aria-hidden="true"></svg>
        </div>
      </section>

      <div class="dl-ticker" data-rv aria-hidden="true" style="--cc:var(--p4)" data-cc="p4"><div class="dl-track" id="track">
        {[0, 1].map(() => V.ticker.map((t) => <span>{t}<i>{V.sep}</i></span>))}
      </div></div>

      <section class="dl-services" aria-label="Servicios">
        {V.services.map((s, i) => (
          <article class="dl-card" data-rv style={`--cc:var(--${svcCC[i]})`} data-cc={svcCC[i]}>
            <span class="dl-pill" data-t={`nums.${i}`}>{V.nums[i]}</span>
            <h2 data-t={`services.${i}.t`}>{s.t}</h2>
            <p data-t={`services.${i}.d`}>{s.d}</p>
            <ul>{s.l.map((x, j) => <li data-t={`services.${i}.l.${j}`}>{x}</li>)}</ul>
          </article>
        ))}
      </section>

      <section class="dl-work" aria-label="Trabajo">
        {V.work.map((w, i) => (
          <a class="dl-card dl-case" data-rv href="#" style={`--cc:var(--${workCC[i]})`} data-cc={workCC[i]}>
            <span class="dl-thumb" aria-hidden="true"></span>
            <span class="dl-meta"><b data-t={`work.${i}.t`}>{w.t}</b><span data-t={`work.${i}.m`}>{w.m}</span></span>
          </a>
        ))}
      </section>
    </main>

    <aside class="dl-console" aria-label="Diales del sistema">
      <div class="dl-knobs" id="knobs"></div>
      <div class="dl-actions">
        <div class="dl-brands" role="group" aria-label="Vestir la web">
          <span class="dl-lbl">vestir</span>
          <button class="dl-btn" data-brand="minervo" aria-pressed="true">minərvo</button>
          <button class="dl-btn" data-brand="coresolutions" aria-pressed="false">coresolutions</button>
          <button class="dl-btn" data-brand="jay" aria-pressed="false">jay jaramillo</button>
          <button class="dl-btn" data-brand="ankla" aria-pressed="false">ankla</button>
        </div>
        <div class="dl-brands">
          <button class="dl-btn" id="dice" title="combinación al azar">azar</button>
          <button class="dl-btn solid" id="save">guardar edición</button>
        </div>
      </div>
      <p class="sr-only" aria-live="polite" id="live"></p>
    </aside>
  </div>
</Base>

<script>
  import { initDiales } from '../../scripts/diales.js';
  initDiales(document.getElementById('dl'));
</script>

<style is:global>
  @font-face{font-family:"Bricolage";src:url("/fonts/BricolageGrotesque-Variable.woff2") format("woff2");font-weight:200 800;font-style:normal;font-display:swap}
  @font-face{font-family:"IBM Plex Sans";src:url("/fonts/IBMPlexSans-Regular.woff2") format("woff2");font-weight:400;font-display:swap}
  @font-face{font-family:"IBM Plex Sans";src:url("/fonts/IBMPlexSans-SemiBold.woff2") format("woff2");font-weight:600;font-display:swap}
  @font-face{font-family:"Geist Mono Var";src:url("/fonts/GeistMono-Variable.woff2") format("woff2");font-weight:100 900;font-display:swap}
  @property --g{syntax:'<color>';inherits:true;initial-value:#f4ebe1}
  @property --t{syntax:'<color>';inherits:true;initial-value:#0b0b0d}
  @property --ci{syntax:'<color>';inherits:true;initial-value:#0b0b0d}
  @property --paper{syntax:'<color>';inherits:true;initial-value:#fffaf3}
  @property --p0{syntax:'<color>';inherits:true;initial-value:#5fe3a1}
  @property --p1{syntax:'<color>';inherits:true;initial-value:#ff5b2e}
  @property --p2{syntax:'<color>';inherits:true;initial-value:#ffb800}
  @property --p3{syntax:'<color>';inherits:true;initial-value:#1fbf5f}
  @property --p4{syntax:'<color>';inherits:true;initial-value:#ff9ec7}
  @property --p5{syntax:'<color>';inherits:true;initial-value:#9b7bff}

  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .skip{position:absolute;left:-9999px}
  .dl{
    --e:.5; --r:.5; --c:.6; --k:0;
    --s:calc(.75 + var(--e) * .7);
    --wmax:800; --rot:1; --bdmin:0%;
    --ease:cubic-bezier(.34,1.56,.64,1); --dur:.6s;
    --w:min(calc(420 + var(--c) * 380),var(--wmax));
    --gap:calc((6px + (1 - var(--r)) * 22px) * var(--s));
    --radius-card:32;
    --font:"Geist",system-ui,sans-serif;
    --hfont:"Bricolage","Geist",sans-serif;
    --case:none;
    --rad:calc(var(--radius-card) * 1px * (.5 + var(--s) * .5));
    min-height:100dvh;background:var(--g);color:var(--t);font-family:var(--font);
    transition:--g .7s,--t .7s,--ci .7s,--paper .7s,--p0 .7s,--p1 .7s,--p2 .7s,--p3 .7s,--p4 .7s,--p5 .7s;
    padding:0 max(12px,2vw) 240px;overflow-x:hidden;
  }
  .dl.no-tr,.dl.no-tr *{transition:none!important}
  :where(.dl) a{color:inherit;text-decoration:none}

  /* tarjeta base: con contraste bajo se vuelve papel con borde; con contraste alto, bloque de color */
  .dl-card{
    --bg:color-mix(in oklab,var(--cc) calc(var(--c) * 100%),var(--paper));
    background:var(--bg);color:var(--ci);border-radius:var(--rad);
    border:1.5px solid color-mix(in oklab,var(--t) max(calc((1 - var(--c)) * 70%),var(--bdmin)),transparent);
    padding:calc(22px * var(--s));
    transform:rotate(calc(var(--rr,0) * var(--k) * var(--rot) * 6deg)) translateY(calc(var(--ry,0) * var(--k) * 24px));
    transition:transform var(--dur) var(--ease),rotate .45s cubic-bezier(.34,1.56,.64,1),scale .45s cubic-bezier(.34,1.56,.64,1),border-radius .5s,padding .5s,box-shadow .2s;
  }
  .dl-pill{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:0 14px;border:1.5px solid currentColor;border-radius:999px;font-size:13px;font-weight:500;white-space:nowrap}

  /* nav: bloques de color */
  .dl-nav{position:sticky;top:0;z-index:3;display:flex;align-items:center;gap:12px;padding:12px 0;background:linear-gradient(var(--g) 70%,transparent)}
  .dl-wm{font-family:var(--hfont);font-weight:min(800,var(--wmax));font-size:clamp(28px,3.2vw,44px);letter-spacing:-.04em;line-height:1;text-transform:var(--case);margin-right:auto}
  .dl-wm i{font-style:normal;color:var(--p1)}
  .dl-wear{font-size:.45em;letter-spacing:0;font-weight:500;margin-left:.4em;opacity:.7}
  .dl-tiles{display:flex;gap:6px}
  .dl-tile{display:grid;grid-template-columns:auto 1fr auto;gap:2px 10px;align-items:end;width:clamp(110px,10vw,150px);height:64px;padding:10px 12px;border-radius:14px;
    background:color-mix(in oklab,var(--cc) calc(var(--c) * 100%),var(--paper));color:var(--ci);font-size:13px;font-weight:500;transition:transform .25s}
  .dl-tile span:first-child{align-self:start;grid-column:1}
  .dl-tile span:last-child{grid-row:1;grid-column:3;align-self:start}
  .dl-tile b{grid-column:1/-1;font-weight:600;font-size:14px}
  .dl-tile:hover{transform:translateY(-3px)}
  .dl-ed{font-family:var(--mono);font-size:12px}
  @media (max-width:900px){.dl-tiles{display:none}}

  /* hero en bento */
  .dl-bento{display:grid;grid-template-columns:7fr 5fr;gap:var(--gap)}
  .dl-hero{display:flex;flex-direction:column;align-items:flex-start;gap:calc(18px * var(--s));min-height:min(78vh,720px);justify-content:space-between}
  .dl-h1{
    font-family:var(--hfont);text-transform:var(--case);font-weight:var(--w);font-variation-settings:"wght" var(--w);
    font-size:calc(clamp(44px,7.4vw,124px) * var(--s));line-height:calc(1 - var(--r) * .1);letter-spacing:-.035em;margin:auto 0 0;max-width:11ch;
    transition:font-size .5s,line-height .5s,font-weight .5s;
  }
  .dl-h1 .w{display:inline-block;white-space:nowrap}
  .dl-h1 .hlw{background:var(--cc);color:var(--ci);border-radius:.25em;padding:0 .12em;margin:0 -.04em}
  .dl-h1 .ch{display:inline-block;transform:translate(calc(var(--rx) * var(--k) * .1em),calc(var(--ry) * var(--k) * .18em)) rotate(calc(var(--rr) * var(--k) * var(--rot) * 16deg));transition:transform var(--dur) var(--ease)}
  .dl-lead{font-size:calc(17px * min(var(--s),1.2));line-height:1.45;max-width:40ch;margin:0}
  .dl-art{padding:0;overflow:hidden;display:grid;place-items:center}
  .dl-comp{width:100%;height:100%;max-height:min(78vh,720px);display:block}
  .dl-comp g{transition:transform var(--dur) var(--ease),opacity .4s;transform-box:view-box}
  .dl-comp .sh{transition:fill .7s,stroke .7s}
  @media (max-width:760px){.dl-bento{grid-template-columns:1fr}.dl-hero{min-height:0}.dl-art{aspect-ratio:1}}

  /* cinta */
  .dl-ticker{margin:var(--gap) 0;border-radius:999px;background:color-mix(in oklab,var(--cc) calc(var(--c) * 100%),var(--paper));color:var(--ci);overflow:hidden;
    border:1.5px solid color-mix(in oklab,var(--t) max(calc((1 - var(--c)) * 70%),var(--bdmin)),transparent)}
  .dl-track{display:flex;width:max-content;animation:dl-tick calc(14s + (1 - var(--r)) * 30s) linear infinite}
  .dl-track span{font-family:var(--hfont);font-weight:var(--w);text-transform:var(--case);font-size:calc(20px * var(--s));padding:10px 0 10px 22px;white-space:nowrap}
  .dl-track i{font-style:normal;margin-left:22px}
  @keyframes dl-tick{to{transform:translateX(-50%)}}

  /* servicios */
  .dl-services{display:grid;grid-template-columns:repeat(auto-fit,minmax(calc(200px + var(--e) * 80px),1fr));gap:var(--gap);margin-bottom:var(--gap)}
  .dl-services .dl-card{display:flex;flex-direction:column;align-items:flex-start;gap:10px;min-height:calc(300px * var(--s))}
  .dl-services h2{font-family:var(--hfont);text-transform:var(--case);font-weight:var(--w);font-variation-settings:"wght" var(--w);font-size:calc(30px * var(--s));line-height:1;letter-spacing:-.03em;margin:auto 0 0}
  .dl-services p{margin:0;font-weight:500}
  .dl-services ul{list-style:none;margin:6px 0 0;padding:0;width:100%}
  .dl-services li{padding:7px 0;border-bottom:1.5px solid currentColor;font-size:15px}

  /* trabajo */
  .dl-work{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:var(--gap)}
  .dl-case{display:flex;flex-direction:column;gap:14px;padding:10px}
  .dl-thumb{aspect-ratio:4/3;border-radius:calc(var(--rad) - 10px);background:
    radial-gradient(circle at 30% 40%,var(--paper) 0 18%,transparent 18.5%),
    linear-gradient(135deg,color-mix(in oklab,var(--ci) 12%,transparent),transparent);border:1.5px solid color-mix(in oklab,var(--ci) 25%,transparent)}
  .dl-meta{display:flex;justify-content:space-between;align-items:baseline;gap:12px;padding:0 8px 6px}
  .dl-meta b{font-family:var(--hfont);font-weight:var(--w);text-transform:var(--case);font-size:calc(26px * var(--s));letter-spacing:-.03em}
  .dl-meta span{font-size:13px;opacity:.8}
  .dl-case:hover .dl-thumb{transform:scale(.98)}
  .dl-thumb{transition:transform .3s}

  /* consola */
  .dl-console{position:fixed;left:50%;bottom:max(12px,env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:5;width:min(780px,calc(100vw - 24px));
    background:#0b0b0d;color:#fffaf3;border-radius:28px;padding:14px 18px;display:flex;flex-wrap:wrap;gap:12px 20px;align-items:center;justify-content:space-between;
    box-shadow:0 18px 50px #0b0b0d40;font-family:"Geist",system-ui,sans-serif}
  .dl-knobs{display:flex;gap:14px}
  .knob{display:flex;flex-direction:column;align-items:center;gap:3px;touch-action:none;cursor:ns-resize;user-select:none;-webkit-user-select:none;border-radius:14px;padding:2px}
  .knob svg{width:60px;height:60px;display:block}
  .knob .mono{font-family:"Geist",sans-serif;font-size:11px;line-height:13px;color:#b9b4ab;text-transform:none;letter-spacing:0}
  .knob .val{color:#fffaf3;font-family:var(--mono)}
  .knob:focus-visible{outline:2px solid #5fe3a1;outline-offset:2px}
  .dl-actions{display:flex;flex-direction:column;gap:8px;align-items:flex-end}
  .dl-brands{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
  .dl-lbl{color:#b9b4ab;font-size:13px;margin-right:2px}
  .dl-btn{font:inherit;font-size:13px;font-weight:500;min-height:36px;padding:0 14px;border-radius:999px;border:1.5px solid #3a3a40;background:transparent;color:#fffaf3;cursor:pointer}
  .dl-btn sup{font-size:9px;margin-left:2px;color:#b9b4ab}
  .dl-btn[aria-pressed="true"]{background:#fffaf3;color:#0b0b0d;border-color:#fffaf3}
  .dl-btn.solid{background:#ffb800;color:#0b0b0d;border-color:#ffb800}
  @media (max-width:600px){
    .dl-console{border-radius:22px;padding:10px;gap:10px;justify-content:center}
    .dl-knobs{gap:6px;width:100%;justify-content:space-around}
    .knob svg{width:50px;height:50px}
    .dl-actions{align-items:center;width:100%}
    .dl-brands{justify-content:center}
    .dl-ed{display:none}
  }

  /* llamada a la acción y piezas comunes */
  .dl-cta{display:inline-flex;align-items:center;min-height:52px;padding:0 24px;border-radius:999px;background:var(--t);color:var(--g)!important;font-weight:600;font-size:16px;transition:transform var(--dur) var(--ease),background .2s}
  .dl-cta:hover{transform:translateY(-3px) rotate(calc(-3deg * var(--rot)))}
  .dl li:empty{display:none}
  .dl-art{color:var(--ci)}

  /* ===== Coresolutions: retícula de línea fina, esquinas a 0, datos en mono, movimiento preciso ===== */
  [data-brand=coresolutions]{--ease:cubic-bezier(.2,0,0,1);--dur:.32s}
  [data-brand=coresolutions] .dl-bento,[data-brand=coresolutions] .dl-services,[data-brand=coresolutions] .dl-work{gap:0}
  [data-brand=coresolutions] .dl-card{border:1px solid #c8ccd5;margin:0 -1px -1px 0}
  [data-brand=coresolutions] .dl-hero{background-image:linear-gradient(#e2e5ec 1px,transparent 1px),linear-gradient(90deg,#e2e5ec 1px,transparent 1px);background-size:48px 48px;background-position:-1px -1px}
  [data-brand=coresolutions] .dl-art{background-image:linear-gradient(#161f7e 1px,transparent 1px),linear-gradient(90deg,#161f7e 1px,transparent 1px);background-size:5% 5%}
  [data-brand=coresolutions] .dl-pill{border-radius:2px;font-family:var(--mono);text-transform:uppercase;letter-spacing:.06em;font-size:12px;min-height:26px;padding:0 10px;border-width:1px}
  [data-brand=coresolutions] .dl-h1{letter-spacing:-.02em;line-height:1.05;max-width:13ch}
  [data-brand=coresolutions] .dl-h1 .hlw{border-radius:0}
  [data-brand=coresolutions] .dl-lead{font-size:17px;max-width:46ch}
  [data-brand=coresolutions] .dl-cta{border-radius:0;background:#01095c;color:#fff!important;font-weight:600;min-height:48px}
  [data-brand=coresolutions] .dl-cta:hover{background:#0c1071;transform:none;box-shadow:0 4px 12px rgba(1,9,92,.16)}
  [data-brand=coresolutions] .dl-ticker{border-radius:0;margin:0 0 -1px;border:1px solid #c8ccd5}
  [data-brand=coresolutions] .dl-track span{font-family:var(--mono);font-size:14px;text-transform:uppercase;letter-spacing:.06em;font-weight:500;padding:12px 0 12px 22px}
  [data-brand=coresolutions] .dl-tile{border-radius:0;height:56px}
  [data-brand=coresolutions] .dl-tile span:first-child{font-family:var(--mono);font-size:11px}
  [data-brand=coresolutions] .dl-services li{font-family:var(--mono);font-size:13px;border-bottom-width:1px}
  [data-brand=coresolutions] .dl-services li::before{content:"→ "}
  [data-brand=coresolutions] .dl-meta span{font-family:var(--mono);font-size:12px;letter-spacing:.06em}
  [data-brand=coresolutions] .dl-thumb{border-radius:0;background-image:linear-gradient(color-mix(in oklab,var(--ci) 18%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in oklab,var(--ci) 18%,transparent) 1px,transparent 1px);background-size:24px 24px}
  [data-brand=coresolutions] .dl-case:hover{box-shadow:0 4px 12px rgba(1,9,92,.16);position:relative;z-index:1}
  [data-brand=coresolutions] .dl-wm{letter-spacing:-.02em}

  /* ===== Jay Jaramillo: negro, mono, texto chico, mucho vacío, sin adornos, movimiento lento ===== */
  [data-brand=jay]{--ease:cubic-bezier(.4,0,.2,1);--dur:.9s}
  [data-brand=jay] .dl-hero{justify-content:center;gap:28px}
  [data-brand=jay] .dl-h1{font-size:min(calc(clamp(44px,7.4vw,124px) * var(--s)),56px);letter-spacing:0;line-height:1.25;max-width:16ch;margin:0}
  [data-brand=jay] .dl-h1 .hlw{border-radius:0;padding:0 .15em;margin:0}
  [data-brand=jay] .dl-lead{font-size:14px;max-width:34ch;color:#8a8a8a}
  [data-brand=jay] .dl-pill{border:0;padding:0;min-height:0;font-size:12px;color:#8a8a8a}
  [data-brand=jay] .dl-cta{background:none;color:#fff!important;padding:0 0 2px;min-height:0;border-bottom:1px solid #fff;border-radius:0;font-weight:500;font-size:14px}
  [data-brand=jay] .dl-cta:hover{transform:none;opacity:.6}
  [data-brand=jay] .dl-tile{background:none!important;color:#fff!important;height:auto;width:auto;padding:4px 8px;display:inline-flex;gap:8px;align-items:baseline}
  [data-brand=jay] .dl-tile b{font-weight:500;font-size:13px}
  [data-brand=jay] .dl-tile span:first-child{color:#8a8a8a;font-size:12px}
  [data-brand=jay] .dl-tile span:last-child{display:none}
  [data-brand=jay] .dl-ticker{border:0;border-top:1px solid #262626;border-bottom:1px solid #262626;border-radius:0;background:none!important}
  [data-brand=jay] .dl-track{animation-duration:90s}
  [data-brand=jay] .dl-track span{font-size:13px;font-weight:500;padding:14px 0 14px 28px;color:#8a8a8a}
  [data-brand=jay] .dl-track i{margin-left:28px}
  [data-brand=jay] .dl-services .dl-card{min-height:calc(200px * var(--s))}
  [data-brand=jay] .dl-services h2{font-size:min(calc(30px * var(--s)),24px);letter-spacing:0}
  [data-brand=jay] .dl-services p{font-weight:400;font-size:14px;opacity:.6}
  [data-brand=jay] .dl-services li{border:0;padding:2px 0;font-size:13px}
  [data-brand=jay] .dl-services li::before{content:"— "}
  [data-brand=jay] .dl-meta b{font-size:18px;letter-spacing:0}
  [data-brand=jay] .dl-meta span{font-size:12px}
  [data-brand=jay] .dl-thumb{border-radius:0;background:none;border-color:#262626}
  [data-brand=jay] .dl-wm{font-size:22px;letter-spacing:0}
  ::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
  ::view-transition-new(root){animation:dl-wipe .8s cubic-bezier(.7,0,.2,1)}
  @keyframes dl-wipe{from{clip-path:circle(0 at var(--vx,50%) var(--vy,100%))}to{clip-path:circle(150% at var(--vx,50%) var(--vy,100%))}}

  /* ===================== animación por marca ===================== */
